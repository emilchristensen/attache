{
  "name": "attache",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tests/e2e/tsconfig.json",
    "lint": "node scripts/check-docs.mjs && eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "release": "node scripts/build-release.mjs",
    "verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@attache/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.1.0"
  }
}
